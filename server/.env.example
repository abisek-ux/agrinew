# Port configuration (set automatically by hosting providers like Render / Railway)
PORT=5000

# Secret keys for JWT and OTP encryption
JWT_SECRET=your_super_secret_jwt_key_here
RESET_OTP_PEPPER=your_secret_otp_pepper_here

# Allowed origins for CORS (comma-separated, or * for all)
CLIENT_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# MongoDB Atlas URI (leave empty for built-in in-memory store)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/?retryWrites=true&w=majority

# Twilio SMS Configuration (Optional)
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1234567890
TWILIO_VERIFY_SERVICE_SID=

# Email Configuration - Nodemailer (Optional)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=465
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_email_app_password

# OTP Expiration and Rate Limits
PASSWORD_RESET_OTP_TTL_MINUTES=10
PASSWORD_RESET_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MAX_REQUESTS_PER_HOUR=5
PASSWORD_RESET_MAX_VERIFY_ATTEMPTS=5
